rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Roles (se reconocen por el correo de la cuenta creada en Authentication) ──
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'sn.entertainment.bo@gmail.com'; }
    function isDoor()   { return signedIn() && request.auth.token.email == 'puerta@sn-entertainment.bo'; }
    function orderOf(id) { return get(/databases/$(database)/documents/orders/$(id)).data; }
    function autoOn()   { return get(/databases/$(database)/documents/config/settings).data.autoApprove == true; }

    // Eventos y ajustes: todo el mundo lee, solo el administrador escribe.
    match /events/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /config/{doc}  { allow read: if true; allow write: if isAdmin(); }

    // Pedidos: el comprador crea el suyo (id secreto) y lo completa una sola vez; solo el administrador lista y modifica el resto.
    match /orders/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','uid','eventId','event','eventDate','items','total','buyer','status','createdAt'])
        && request.resource.data.id == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total < 20000
        && request.resource.data.items is list && request.resource.data.items.size() <= 8
        && request.resource.data.buyer.name is string && request.resource.data.buyer.name.size() < 120
        && request.resource.data.buyer.email is string && request.resource.data.buyer.email.size() < 160
        && request.resource.data.buyer.phone is string && request.resource.data.buyer.phone.size() < 30;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status in ['review','approved']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rid','checks','receiptAt','tickets']));
      allow delete: if isAdmin();
    }

    // Entradas: las crea el dueño del pedido (solo si la aprobación automática está activa); la puerta solo puede marcar ingresos.
    match /tickets/{id} {
      allow create: if isAdmin()
        || (signedIn() && autoOn() && orderOf(request.resource.data.orderId).uid == request.auth.uid
            && request.resource.data.used == 0 && request.resource.data.active == true && request.resource.data.max <= 2);
      allow get: if isAdmin() || isDoor();
      allow list: if isAdmin();
      allow update: if isAdmin()
        || (isDoor() && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','scans'])
            && request.resource.data.used == resource.data.used + 1 && request.resource.data.used <= resource.data.max);
      allow delete: if isAdmin();
    }

    // Comprobantes: se reservan una sola vez (nadie puede reutilizarlos) y solo el administrador los ve.
    match /rkeys/{k} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['orderId','ts']);
      allow delete: if isAdmin();
    }
    match /receipts/{orderId} {
      allow create: if signedIn() && orderOf(orderId).uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Datos de versiones anteriores (solo lectura del administrador, para migrar).
    match /kv/{doc} { allow read, write: if isAdmin(); }

    // Todo lo demás, cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
